<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PiperPlus.Cli.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTrimmable>false</IsTrimmable>
    <!-- Suppress trim warnings: we source-link the CLI engine adapters
         (DotNetG2PEngine etc.) which use reflection in MultilingualPhonemizer's
         delegating dispatch path. Same intent as PiperPlus.Cli.csproj /
         PiperPlus.Bench.csproj. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
    <PackageReference Include="DotNetG2P" Version="1.8.0" />
    <PackageReference Include="DotNetG2P.MeCab" Version="1.8.0" />
    <PackageReference Include="DotNetG2P.English" Version="1.8.0" />
    <PackageReference Include="DotNetG2P.Spanish" Version="1.8.0" />
    <PackageReference Include="DotNetG2P.French" Version="1.8.0" />
    <PackageReference Include="DotNetG2P.Portuguese" Version="1.8.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiperPlus.Core\PiperPlus.Core.csproj" />
  </ItemGroup>

  <!-- Shared numeric-tone pinyin dictionaries for BundledChineseG2PEngine,
       linked from the canonical copy (docs/spec/dictionary-mirrors.toml). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\rust\piper-plus-g2p\data\pinyin_single.json" LogicalName="PiperPlus.Cli.pinyin_single.json" Link="Data\pinyin_single.json" />
    <EmbeddedResource Include="..\..\rust\piper-plus-g2p\data\pinyin_phrases.json" LogicalName="PiperPlus.Cli.pinyin_phrases.json" Link="Data\pinyin_phrases.json" />
  </ItemGroup>

  <!-- Source-link the CLI's per-language engine adapters so the test process
       exercises the exact same JA/EN engine wiring the CLI uses. The
       DotNetG2PEngine class is internal to PiperPlus.Cli (not transitively
       reachable from PiperPlus.Core.Tests), so source-linking is the only way
       to test its concurrency contract without making it public API. Same
       approach as PiperPlus.Bench.csproj. -->
  <ItemGroup>
    <Compile Include="..\PiperPlus.Cli\DotNetG2PEngine.cs" Link="Adapters\DotNetG2PEngine.cs" />
    <Compile Include="..\PiperPlus.Cli\DotNetEnglishG2PEngine.cs" Link="Adapters\DotNetEnglishG2PEngine.cs" />
    <Compile Include="..\PiperPlus.Cli\BundledChineseG2PEngine.cs" Link="Adapters\BundledChineseG2PEngine.cs" />
    <!-- Program.ResolveTextModePhonemizer and every engine it constructs:
         G2pGoldenParityTests compares the phonemes a CLI text-mode (language xx)
         user gets with the Python golden, so it must build the phonemizer
         exactly as the CLI does. -->
    <Compile Include="..\PiperPlus.Cli\TextModePhonemizer.cs" Link="Adapters\TextModePhonemizer.cs" />
    <Compile Include="..\PiperPlus.Cli\DotNetKoreanG2PEngine.cs" Link="Adapters\DotNetKoreanG2PEngine.cs" />
    <Compile Include="..\PiperPlus.Cli\DotNetSpanishG2PEngine.cs" Link="Adapters\DotNetSpanishG2PEngine.cs" />
    <Compile Include="..\PiperPlus.Cli\DotNetFrenchG2PEngine.cs" Link="Adapters\DotNetFrenchG2PEngine.cs" />
    <Compile Include="..\PiperPlus.Cli\DotNetPortugueseG2PEngine.cs" Link="Adapters\DotNetPortugueseG2PEngine.cs" />
    <Compile Include="..\PiperPlus.Cli\DotNetSwedishG2PEngine.cs" Link="Adapters\DotNetSwedishG2PEngine.cs" />
    <!-- Program.WriteFatalDiagnostics: the format of the CLI's fatal-error
         output is what issue #735 depends on the next time its intermittent
         failure happens, so it is asserted rather than hoped for. Program.cs
         itself cannot be source-linked (its Main would collide with the test
         host's entry point), which is why the method lives in its own file. -->
    <Compile Include="..\PiperPlus.Cli\TimingOutput.cs" Link="Adapters\TimingOutput.cs" />
    <Compile Include="..\PiperPlus.Cli\FatalDiagnostics.cs" Link="Adapters\FatalDiagnostics.cs" />
  </ItemGroup>

</Project>
