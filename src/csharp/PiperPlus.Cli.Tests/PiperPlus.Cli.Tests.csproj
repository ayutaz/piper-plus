<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PiperPlus.Cli.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTrimmable>false</IsTrimmable>
    <!-- Suppress trim warnings: the referenced CLI engine adapters
         (DotNetG2PEngine etc.) use reflection in MultilingualPhonemizer's
         delegating dispatch path. Same intent as PiperPlus.Cli.csproj /
         PiperPlus.Bench.csproj. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiperPlus.Core\PiperPlus.Core.csproj" />
    <!-- The CLI's engine adapters, TextModePhonemizer and helpers are internal
         to PiperPlus.Cli (InternalsVisibleTo). Referencing the project instead
         of source-linking its files tests the exact wiring the CLI ships, and
         its G2P packages come with it rather than as new direct dependencies. -->
    <ProjectReference Include="..\PiperPlus.Cli\PiperPlus.Cli.csproj" />
  </ItemGroup>

</Project>
