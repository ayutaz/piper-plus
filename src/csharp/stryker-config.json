{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/docs/stryker-config.schema.json",
  "stryker-config": {
    "project": "PiperPlus.Core/PiperPlus.Core.csproj",
    "solution": "PiperPlus.sln",
    "test-projects": [
      "PiperPlus.Core.Tests/PiperPlus.Core.Tests.csproj"
    ],
    "mutate": [
      "Phonemize/MultilingualPhonemizer.cs",
      "Phonemize/InlinePhonemeParser.cs",
      "Phonemize/IpaTokenizer.cs",
      "Phonemize/ArpabetToIPAConverter.cs",
      "Ssml/SsmlParser.cs"
    ],
    "thresholds": {
      "high": 95,
      "low": 90,
      "break": 90
    },
    "reporters": [
      "html",
      "json",
      "progress",
      "cleartext"
    ],
    "test-runner": "mtp",
    "concurrency": 4,
    "disable-mix-mutants": false,
    "language-version": "Latest",
    "since": {
      "enabled": false,
      "target": "dev"
    }
  }
}
